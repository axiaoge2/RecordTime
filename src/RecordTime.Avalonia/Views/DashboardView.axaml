<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="RecordTime.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0" Margin="24,20,24,32">

            <!-- Header Card - Editorial Style -->
            <Border BorderBrush="{DynamicResource LinearBorderFocusBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,16,0,8">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TodayFocusDuration, Source={x:Static strings:StringResources.Current}}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   LetterSpacing="1.5"
                                   Foreground="{DynamicResource LinearFgTertiaryBrush}"/>
                        
                        <!-- Date -->
                        <TextBlock Text="{Binding SelectedDateText}"
                                   FontSize="14"
                                   FontFamily="{DynamicResource EditorialSerifFont}"
                                   Foreground="{DynamicResource LinearFgSecondaryBrush}"/>
                        
                        <!-- Total Duration - Big Number -->
                        <TextBlock Text="{Binding TotalDuration}"
                                   FontSize="64"
                                   FontFamily="{DynamicResource EditorialSerifFont}"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource LinearFgPrimaryBrush}"
                                   Margin="0,8,0,12"/>
                        
                        <!-- Status -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Recording indicator with pulse animation -->
                            <Panel IsVisible="{Binding IsMonitoring}">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource LinearFgPrimaryBrush}" Opacity="0.3">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource LinearFgPrimaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource LinearFgMutedBrush}"
                                     IsVisible="{Binding !IsMonitoring}"/>
                            
                            <!-- 专注状态文本 -->
                            <TextBlock Text="{Binding MonitoringRunning, Source={x:Static strings:StringResources.Current}}"
                                       IsVisible="{Binding IsMonitoring}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       LetterSpacing="1.5"
                                       Foreground="{DynamicResource LinearFgPrimaryBrush}"/>
                            <TextBlock Text="{Binding MonitoringStopped, Source={x:Static strings:StringResources.Current}}"
                                       IsVisible="{Binding !IsMonitoring}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       LetterSpacing="1.5"
                                       Foreground="{DynamicResource LinearFgMutedBrush}"/>
                            
                            <!-- Last update time -->
                            <TextBlock Text="{Binding DataUpdateTime, StringFormat='· {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource LinearFgMutedBrush}"
                                       IsVisible="{Binding IsMonitoring}"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Start/Stop Button - Editorial Style (Pill shape, High Contrast) -->
                    <Button Grid.Column="1"
                            Command="{Binding ToggleMonitoringCommand}"
                            VerticalAlignment="Center"
                            Padding="32,16"
                            CornerRadius="999"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="{DynamicResource LinearFgPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LinearBgPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource LinearFgSecondaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="{Binding StartButtonText}"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1"
                                   FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Top Apps Table - Editorial Style -->
            <Border BorderBrush="{DynamicResource LinearBorderFocusBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,0"
                    Padding="0,8,0,0">
                <StackPanel Spacing="24">
                    <TextBlock Text="{Binding Top10AppsTitle, Source={x:Static strings:StringResources.Current}}"
                               FontSize="24"
                               FontFamily="{DynamicResource EditorialSerifFont}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource LinearFgPrimaryBrush}"/>

                    <DataGrid ItemsSource="{Binding TopApps}"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowBackground="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource LinearBorderSubtleBrush}"
                              CornerRadius="8"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource LinearBorderSubtleBrush}"
                              MaxHeight="500"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource LinearBgTertiaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LinearFgSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="16,12"/>
                            </Style>
                            <Style Selector="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="DataGridRow:pointerover">
                                <Setter Property="Background" Value="{DynamicResource LinearBgHoverBrush}"/>
                            </Style>
                            <Style Selector="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{Binding ColumnAppName, Source={x:Static strings:StringResources.Current}}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,8">
                                            <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                            <TextBlock Text="{Binding AppName}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource LinearFgPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding ColumnUsageTime, Source={x:Static strings:StringResources.Current}}"
                                                Binding="{Binding DurationText}"
                                                Width="140"/>
                            <DataGridTemplateColumn Header="{Binding ColumnPercentage, Source={x:Static strings:StringResources.Current}}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,8">
                                            <ProgressBar Value="{Binding Percentage}"
                                                         Maximum="100"
                                                         Height="8"
                                                         CornerRadius="4"
                                                         Background="{DynamicResource LinearProgressBgBrush}"
                                                         Foreground="{DynamicResource LinearProgressFillBrush}"/>
                                            <TextBlock Text="{Binding Percentage, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource LinearFgSecondaryBrush}"
                                                       Margin="0,-20,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
