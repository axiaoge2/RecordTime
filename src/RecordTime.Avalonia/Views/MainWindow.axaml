<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordTime.Avalonia.ViewModels"
        xmlns:local="using:RecordTime.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RecordTime.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Title="{Binding AppTitle, Source={x:Static strings:StringResources.Current}}"
        WindowStartupLocation="CenterScreen"
        Width="1050"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        Background="{DynamicResource LinearBgPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        TransparencyLevelHint="None">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- Title Bar Area -->
        <Border Height="32"
                VerticalAlignment="Top"
                Background="{DynamicResource LinearBgPrimaryBrush}"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding AppTitle, Source={x:Static strings:StringResources.Current}}"
                       FontSize="12"
                       Foreground="{DynamicResource LinearFgTertiaryBrush}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Border>

        <!-- Main Layout -->
        <SplitView DisplayMode="CompactInline"
                   Margin="0,32,0,0"
                   IsPaneOpen="True"
                   OpenPaneLength="240"
                   CompactPaneLength="56"
                   PaneBackground="{DynamicResource LinearSidebarBgBrush}">
                <SplitView.Pane>
                    <Border BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource LinearBorderSubtleBrush}"
                            Padding="12,16">
                        <ListBox SelectionMode="Single"
                                 SelectedIndex="{Binding SelectedTabIndex}"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearFgSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource LinearSidebarItemHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource LinearSidebarItemActiveBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearSidebarItemActiveTextBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource LinearSidebarItemActiveTextBrush}"/>
                                </Style>
                            </ListBox.Styles>

                            <!-- Dashboard -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationDashboard, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- App Stats -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationAppStats, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Reports -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationReports, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Time Budget -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationTimeBudget, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Settings -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationSettings, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- About -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationAbout, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>
                        </ListBox>
                    </Border>
                </SplitView.Pane>

                <SplitView.Content>
                    <Border Margin="0"
                            Background="{DynamicResource LinearBgSecondaryBrush}"
                            ClipToBounds="True">
                        <TransitioningContentControl Content="{Binding CurrentPageViewModel}">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.2" />
                            </TransitioningContentControl.PageTransition>
                            <TransitioningContentControl.DataTemplates>
                                <!-- DashboardViewModel -> DashboardView -->
                                <DataTemplate DataType="vm:DashboardViewModel">
                                    <local:DashboardView/>
                                </DataTemplate>
                                <!-- AppStatsViewModel -> AppStatsView -->
                                <DataTemplate DataType="vm:AppStatsViewModel">
                                    <local:AppStatsView/>
                                </DataTemplate>
                                <!-- ReportViewModel -> ReportView -->
                                <DataTemplate DataType="vm:ReportViewModel">
                                    <local:ReportView/>
                                </DataTemplate>
                                <!-- SettingsViewModel -> SettingsView -->
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <local:SettingsView/>
                                </DataTemplate>
                                <!-- AboutViewModel -> AboutView -->
                                <DataTemplate DataType="vm:AboutViewModel">
                                    <local:AboutView/>
                                </DataTemplate>
                                <!-- TimeBudgetViewModel -> TimeBudgetView -->
                                <DataTemplate DataType="vm:TimeBudgetViewModel">
                                    <local:TimeBudgetView/>
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                        </TransitioningContentControl>
                    </Border>
                </SplitView.Content>
            </SplitView>

        <!-- AI Coach 悬浮面板 -->
        <local:AICoachPanel DataContext="{Binding AICoachVM}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
    </Panel>
</Window>
