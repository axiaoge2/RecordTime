<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordTime.Avalonia.ViewModels"
        xmlns:local="using:RecordTime.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RecordTime.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RecordTime - 时间追踪工具"
        WindowStartupLocation="CenterScreen"
        Width="1000"
        Height="700"
        MinWidth="900"
        MinHeight="650">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Main Content Area with Apple-style generous spacing -->
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation (Apple macOS Style) -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0.5,0"
                    Padding="16,32,16,24">
                <StackPanel Spacing="6">
                    <!-- App Title -->
                    <TextBlock Text="RecordTime"
                              Classes="heading"
                              Margin="8,0,0,24"
                              Foreground="{StaticResource PrimaryText}"/>

                    <!-- Navigation Items -->
                    <Button Classes="sidebar-item"
                           Content="📊 仪表盘"
                           Command="{Binding NavigateToDashboardCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="📱 应用统计"
                           Command="{Binding NavigateToAppStatsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="📈 报告"
                           Command="{Binding NavigateToReportsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Separator Margin="0,20"
                              Background="{StaticResource DividerBrush}"
                              Height="0.5"/>

                    <Button Classes="sidebar-item"
                           Content="⚙️ 设置"
                           Command="{Binding NavigateToSettingsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="ℹ️ 关于"
                           Command="{Binding NavigateToAboutCommand}"
                           HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Main Content Area with Page Switching -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}">
                <ContentControl.DataTemplates>
                    <!-- AppStatsViewModel -> AppStatsView -->
                    <DataTemplate DataType="vm:AppStatsViewModel">
                        <local:AppStatsView/>
                    </DataTemplate>
                    <!-- ReportViewModel -> ReportView -->
                    <DataTemplate DataType="vm:ReportViewModel">
                        <local:ReportView/>
                    </DataTemplate>
                    <!-- SettingsViewModel -> SettingsView -->
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <local:SettingsView/>
                    </DataTemplate>
                    <!-- AboutViewModel -> AboutView -->
                    <DataTemplate DataType="vm:AboutViewModel">
                        <local:AboutView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Dashboard Content (shown when CurrentPageViewModel is null) -->
            <ScrollViewer Grid.Column="1"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         IsVisible="{Binding ShowDashboard}">
                <StackPanel Spacing="24" MaxWidth="1400" Margin="48,40,48,80">
                    <!-- Page Title with Apple-style large heading -->
                    <TextBlock Text="今日概览"
                              Classes="title"
                              Margin="0,0,0,16"/>

                    <!-- Date Navigator with Apple-style spacing -->
                    <Border Classes="card"
                           Padding="20,16">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                             VerticalAlignment="Center">
                            <!-- Previous Day Button -->
                            <Button Grid.Column="0"
                                   Classes="secondary"
                                   Content="← 前一天"
                                   Command="{Binding PreviousDayCommand}"
                                   VerticalAlignment="Center"/>

                            <!-- Current Date Display -->
                            <StackPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="8">
                                <TextBlock Text="📅"
                                          FontSize="20"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedDateText}"
                                          Classes="heading"
                                          VerticalAlignment="Center"/>
                                <Button Content="今天"
                                       Classes="secondary"
                                       Command="{Binding TodayCommand}"
                                       Padding="8,4"
                                       FontSize="12"/>
                            </StackPanel>

                            <!-- Next Day Button -->
                            <Button Grid.Column="2"
                                   Classes="secondary"
                                   Content="后一天 →"
                                   Command="{Binding NextDayCommand}"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Summary Cards Grid (Apple Widget Style with generous spacing) -->
                    <Grid ColumnDefinitions="*,24,*"
                         RowDefinitions="Auto"
                         Margin="0,8,0,0">
                        <!-- Card 1: Total Time -->
                        <Border Grid.Column="0"
                               Classes="widget-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="⏱️"
                                          FontSize="28"
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalDuration}"
                                          Classes="number-widget"
                                          Margin="0,4,0,0"/>
                                <TextBlock Classes="caption" Opacity="0.85">
                                    <Run Text="总活动时长"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding DataStatusHint}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <TextBlock Classes="caption"
                                          Opacity="0.65"
                                          FontSize="11"
                                          Margin="0,2,0,0">
                                    <Run Text="更新于 "/>
                                    <Run Text="{Binding DataUpdateTime}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Session Count -->
                        <Border Grid.Column="2"
                               Classes="widget-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="📝"
                                          FontSize="28"
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding SessionCount}"
                                          Classes="number-widget"
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="会话数量"
                                          Classes="caption"
                                          Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- App Type Distribution - Large Donut Chart -->
                    <Border Classes="card"
                           Padding="32,28,32,32">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Header -->
                            <TextBlock Grid.Row="0"
                                      Text="📱 应用类型分布"
                                      Classes="heading"
                                      Margin="0,0,0,20"/>

                            <!-- Donut Chart with Center Text -->
                            <Grid Grid.Row="1"
                                 Height="280">
                                <!-- Donut Chart -->
                                <lvc:PieChart Series="{Binding AppTypePieChartSeries}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"/>

                                <!-- Center Text Overlay -->
                                <StackPanel VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Spacing="4">
                                    <TextBlock Text="{Binding TopCategoryName}"
                                              Classes="heading"
                                              FontSize="18"
                                              HorizontalAlignment="Center"
                                              Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock Text="{Binding TopCategoryDuration}"
                                              Classes="number-widget"
                                              FontSize="28"
                                              HorizontalAlignment="Center"
                                              Foreground="{StaticResource PrimaryGradient}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Monitoring Status Card with enhanced spacing -->
                    <Border Classes="card"
                           Padding="24,20">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                             RowDefinitions="Auto">
                            <StackPanel Grid.Column="0"
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <TextBlock Text="监控状态"
                                          Classes="heading"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- 监控运行中指示器 -->
                                    <Border Width="8" Height="8" CornerRadius="4"
                                           Background="#34C759"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsMonitoring}"/>
                                    <!-- 监控未启动指示器 -->
                                    <Border Width="8" Height="8" CornerRadius="4"
                                           Background="#FF9500"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsMonitoring}"/>
                                    <TextBlock Classes="caption" Opacity="0.85">
                                        <Run Text="{Binding MonitoringStatusText}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Classes="caption" Opacity="0.65" FontSize="12" IsVisible="{Binding !IsMonitoring}">
                                    <Run Text="⚠️ "/>
                                    <Run Text="{Binding DataStatusHint}"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3"
                                   Classes="primary"
                                   Content="{Binding StartButtonText}"
                                   Command="{Binding ToggleMonitoringCommand}"
                                   MinWidth="120"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Top Applications -->
                    <Border Classes="card"
                           Padding="24,20,24,24">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                          Text="TOP 10 应用"
                                          Classes="heading"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding TopApps.Count, StringFormat='当前显示: {0} 个'}"
                                          Classes="caption"
                                          Foreground="{StaticResource SecondaryText}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- App List - ListBox 自带滚动条，确保能滚完所有 10 个 -->
                            <ListBox ItemsSource="{Binding TopApps}"
                                     Height="420"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6"
                                               Background="Transparent"
                                               CornerRadius="6">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Background" Value="{StaticResource HoverBackground}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <!-- Rank -->
                                                <TextBlock Grid.Column="0"
                                                          Text="{Binding RankText}"
                                                          Classes="body"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource PrimaryGradient}"
                                                          Width="40"/>

                                                <!-- App Icon -->
                                                <Image Grid.Column="1"
                                                      Source="{Binding Icon}"
                                                      Width="24"
                                                      Height="24"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="2"
                                                          Text="{Binding AppName}"
                                                          Classes="body"
                                                          VerticalAlignment="Center"/>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3"
                                                          Text="{Binding DurationText}"
                                                          Classes="body"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0"
                                                          Width="80"
                                                          TextAlignment="Right"/>

                                                <!-- Session Count -->
                                                <TextBlock Grid.Column="4"
                                                          Text="{Binding SessionCountText}"
                                                          Classes="caption"
                                                          VerticalAlignment="Center"
                                                          Width="60"
                                                          TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty State - Welcome Guide -->
                            <Border IsVisible="{Binding ShowEmptyState}"
                                   Padding="32"
                                   Margin="0,20,0,20">
                                <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="400">
                                    <!-- Icon -->
                                    <TextBlock Text="📊"
                                              FontSize="56"
                                              HorizontalAlignment="Center"
                                              Opacity="0.9"/>

                                    <!-- Title -->
                                    <TextBlock Text="开始追踪您的时间"
                                              Classes="heading"
                                              FontSize="20"
                                              HorizontalAlignment="Center"
                                              TextAlignment="Center"/>

                                    <!-- Description -->
                                    <TextBlock TextWrapping="Wrap"
                                              TextAlignment="Center"
                                              Classes="caption"
                                              Opacity="0.75"
                                              LineHeight="22">
                                        <Run Text="点击下方的"/><Run Text="启动监控" FontWeight="SemiBold"/><Run Text="按钮，RecordTime 将开始自动记录您的应用使用情况。"/>
                                    </TextBlock>

                                    <!-- Features -->
                                    <StackPanel Spacing="12" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                            <TextBlock Text="自动追踪应用使用时长" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                            <TextBlock Text="智能识别活动类型（视频、游戏等）" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                            <TextBlock Text="数据本地存储，保护您的隐私" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Hint -->
                                    <TextBlock Text="💡 提示：监控在后台运行，不会影响您的正常使用"
                                              Classes="caption"
                                              FontSize="11"
                                              Opacity="0.65"
                                              HorizontalAlignment="Center"
                                              TextAlignment="Center"
                                              TextWrapping="Wrap"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 底部占位元素,确保滚动空间充足 -->
                    <Border Height="1" Background="Transparent"/>
                </StackPanel>
            </ScrollViewer>
    </Grid>
</Window>

