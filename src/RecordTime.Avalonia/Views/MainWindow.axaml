<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordTime.Avalonia.ViewModels"
        xmlns:local="using:RecordTime.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RecordTime.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Title="{Binding AppTitle, Source={x:Static strings:StringResources.Current}}"
        WindowStartupLocation="CenterScreen"
        Width="1050"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        Background="{DynamicResource LinearBgPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        TransparencyLevelHint="None">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- Lucide Icons - Linear Style -->
        <StreamGeometry x:Key="IconDashboard">M3 3h7v9H3V3zm11 0h7v5h-7V3zm0 9h7v9h-7v-9zM3 16h7v5H3v-5z</StreamGeometry>
        <StreamGeometry x:Key="IconStats">M3 3v18h18M7 16v-4m4 4v-8m4 8v-5m4 5v-9</StreamGeometry>
        <StreamGeometry x:Key="IconReports">M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2zM14 2v6h6m-8 4H8m8 4H8m2-8H8</StreamGeometry>
        <StreamGeometry x:Key="IconTimeBudget">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 6v6l4 2</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
        <StreamGeometry x:Key="IconAbout">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5v.01M12 12v5</StreamGeometry>
    </Window.Resources>

    <Panel>
        <!-- Title Bar Area -->
        <Border Height="32"
                VerticalAlignment="Top"
                Background="{DynamicResource LinearBgPrimaryBrush}"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding AppTitle, Source={x:Static strings:StringResources.Current}}"
                       FontSize="12"
                       Foreground="{DynamicResource LinearFgTertiaryBrush}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Border>

        <!-- Main Layout -->
        <SplitView DisplayMode="CompactInline"
                   Margin="0,32,0,0"
                   IsPaneOpen="True"
                   OpenPaneLength="240"
                   CompactPaneLength="56"
                   PaneBackground="{DynamicResource LinearSidebarBgBrush}">
                <SplitView.Pane>
                    <Border BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource LinearBorderSubtleBrush}"
                            Padding="12,16">
                        <ListBox SelectionMode="Single"
                                 SelectedIndex="{Binding SelectedTabIndex}"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearFgSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource LinearSidebarItemHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource LinearSidebarItemActiveBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LinearSidebarItemActiveTextBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource LinearSidebarItemActiveTextBrush}"/>
                                </Style>
                            </ListBox.Styles>

                            <!-- Dashboard -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationDashboard, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- App Stats -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationAppStats, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Reports -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationReports, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Time Budget -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationTimeBudget, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- Settings -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationSettings, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>

                            <!-- About -->
                            <ListBoxItem>
                                <TextBlock Text="{Binding NavigationAbout, Source={x:Static strings:StringResources.Current}}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontFamily="{DynamicResource EditorialSerifFont}"
                                           Margin="16,0,0,0"/>
                            </ListBoxItem>
                        </ListBox>
                    </Border>
                </SplitView.Pane>

                <SplitView.Content>
                    <Border Margin="0"
                            Background="{DynamicResource LinearBgSecondaryBrush}"
                            ClipToBounds="True">
                        <TransitioningContentControl Content="{Binding CurrentPageViewModel}">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.2" />
                            </TransitioningContentControl.PageTransition>
                            <TransitioningContentControl.DataTemplates>
                                <!-- DashboardViewModel -> DashboardView -->
                                <DataTemplate DataType="vm:DashboardViewModel">
                                    <local:DashboardView/>
                                </DataTemplate>
                                <!-- AppStatsViewModel -> AppStatsView -->
                                <DataTemplate DataType="vm:AppStatsViewModel">
                                    <local:AppStatsView/>
                                </DataTemplate>
                                <!-- ReportViewModel -> ReportView -->
                                <DataTemplate DataType="vm:ReportViewModel">
                                    <local:ReportView/>
                                </DataTemplate>
                                <!-- SettingsViewModel -> SettingsView -->
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <local:SettingsView/>
                                </DataTemplate>
                                <!-- AboutViewModel -> AboutView -->
                                <DataTemplate DataType="vm:AboutViewModel">
                                    <local:AboutView/>
                                </DataTemplate>
                                <!-- TimeBudgetViewModel -> TimeBudgetView -->
                                <DataTemplate DataType="vm:TimeBudgetViewModel">
                                    <local:TimeBudgetView/>
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                        </TransitioningContentControl>
                    </Border>
                </SplitView.Content>
            </SplitView>

        <!-- AI Coach 悬浮面板 -->
        <local:AICoachPanel DataContext="{Binding AICoachVM}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
    </Panel>
</Window>
