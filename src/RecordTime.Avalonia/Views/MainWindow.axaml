<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordTime.Avalonia.ViewModels"
        xmlns:local="using:RecordTime.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RecordTime.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Title="{Binding AppTitle, Source={x:Static strings:StringResources.Current}}"
        WindowStartupLocation="CenterScreen"
        Width="1250"
        Height="750"
        MinWidth="1100"
        MinHeight="650">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Main Content Area with Apple-style generous spacing -->
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation (Apple macOS Style) -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0.5,0"
                    Padding="16,32,16,24">
                <StackPanel Spacing="6">
                    <!-- App Title -->
                    <TextBlock Text="RecordTime"
                              Classes="heading"
                              Margin="8,0,0,24"
                              Foreground="{StaticResource PrimaryText}"/>

                    <!-- Navigation Items -->
                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationDashboard, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToDashboardCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationAppStats, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToAppStatsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationReports, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToReportsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationTimeBudget, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToTimeBudgetCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Separator Margin="0,20"
                              Background="{StaticResource DividerBrush}"
                              Height="0.5"/>

                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationSettings, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToSettingsCommand}"
                           HorizontalAlignment="Stretch"/>

                    <Button Classes="sidebar-item"
                           Content="{Binding NavigationAbout, Source={x:Static strings:StringResources.Current}}"
                           Command="{Binding NavigateToAboutCommand}"
                           HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Main Content Area with Page Switching -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}">
                <ContentControl.DataTemplates>
                    <!-- AppStatsViewModel -> AppStatsView -->
                    <DataTemplate DataType="vm:AppStatsViewModel">
                        <local:AppStatsView/>
                    </DataTemplate>
                    <!-- ReportViewModel -> ReportView -->
                    <DataTemplate DataType="vm:ReportViewModel">
                        <local:ReportView/>
                    </DataTemplate>
                    <!-- SettingsViewModel -> SettingsView -->
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <local:SettingsView/>
                    </DataTemplate>
                    <!-- AboutViewModel -> AboutView -->
                    <DataTemplate DataType="vm:AboutViewModel">
                        <local:AboutView/>
                    </DataTemplate>
                    <!-- TimeBudgetViewModel -> TimeBudgetView -->
                    <DataTemplate DataType="vm:TimeBudgetViewModel">
                        <local:TimeBudgetView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Dashboard Content (shown when CurrentPageViewModel is null) -->
            <ScrollViewer Grid.Column="1"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         IsVisible="{Binding ShowDashboard}">
                <StackPanel Spacing="24" MaxWidth="1400" Margin="48,40,48,80">
                    <!-- Page Title with Apple-style large heading -->
                    <TextBlock Text="{Binding DashboardTitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="title"
                              Margin="0,0,0,16"/>

                    <!-- Date Navigator with Apple-style spacing -->
                    <Border Classes="card"
                           Padding="20,16">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                             VerticalAlignment="Center">
                            <!-- Previous Day Button -->
                            <Button Grid.Column="0"
                                   Classes="secondary"
                                   Content="{Binding PreviousDayButton, Source={x:Static strings:StringResources.Current}}"
                                   Command="{Binding PreviousDayCommand}"
                                   VerticalAlignment="Center"/>

                            <!-- Current Date Display -->
                            <StackPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="8">
                                <TextBlock Text="📅"
                                          FontSize="20"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedDateText}"
                                          Classes="heading"
                                          VerticalAlignment="Center"/>
                                <Button Content="{Binding TodayButton, Source={x:Static strings:StringResources.Current}}"
                                       Classes="secondary"
                                       Command="{Binding TodayCommand}"
                                       Padding="8,4"
                                       FontSize="12"/>
                            </StackPanel>

                            <!-- Next Day Button -->
                            <Button Grid.Column="2"
                                   Classes="secondary"
                                   Content="{Binding NextDayButton, Source={x:Static strings:StringResources.Current}}"
                                   Command="{Binding NextDayCommand}"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Summary Cards Grid (Apple Widget Style with generous spacing) -->
                    <Grid ColumnDefinitions="*,24,*"
                         RowDefinitions="Auto"
                         Margin="0,8,0,0">
                        <!-- Card 1: Total Time -->
                        <Border Grid.Column="0"
                               Classes="widget-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="⏱️"
                                          FontSize="28"
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalDuration}"
                                          Classes="number-widget"
                                          Margin="0,4,0,0"/>
                                <TextBlock Classes="caption" Opacity="0.85">
                                    <Run Text="{Binding TotalActivityTime, Source={x:Static strings:StringResources.Current}}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding DataStatusHint}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <TextBlock Classes="caption"
                                          Opacity="0.65"
                                          FontSize="11"
                                          Margin="0,2,0,0">
                                    <Run Text="{Binding UpdatedAt, Source={x:Static strings:StringResources.Current}}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding DataUpdateTime}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Session Count -->
                        <Border Grid.Column="2"
                               Classes="widget-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="📝"
                                          FontSize="28"
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding SessionCount}"
                                          Classes="number-widget"
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SessionCount, Source={x:Static strings:StringResources.Current}}"
                                          Classes="caption"
                                          Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Monitoring Status Card - Centered Position -->
                    <Border Classes="card"
                           Padding="24,20">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                             RowDefinitions="Auto">
                            <StackPanel Grid.Column="0"
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <TextBlock Text="{Binding MonitoringStatus, Source={x:Static strings:StringResources.Current}}"
                                          Classes="heading"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- 监控运行中指示器 -->
                                    <Border Width="8" Height="8" CornerRadius="4"
                                           Background="#34C759"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsMonitoring}"/>
                                    <!-- 监控未启动指示器 -->
                                    <Border Width="8" Height="8" CornerRadius="4"
                                           Background="#FF9500"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsMonitoring}"/>
                                    <TextBlock Classes="caption" Opacity="0.85">
                                        <Run Text="{Binding MonitoringStatusText}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Classes="caption" Opacity="0.65" FontSize="12" IsVisible="{Binding !IsMonitoring}">
                                    <Run Text="⚠️ "/>
                                    <Run Text="{Binding DataStatusHint}"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3"
                                   Classes="primary"
                                   Content="{Binding StartButtonText}"
                                   Command="{Binding ToggleMonitoringCommand}"
                                   MinWidth="120"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- App Type Distribution & Top Apps - Moved Down -->
                    <Border Classes="card"
                           Padding="24,20,24,24">
                        <Grid ColumnDefinitions="*,24,*">

                            <!-- 左侧：应用类型分布 -->
                            <StackPanel Grid.Column="0" Spacing="16">
                                <TextBlock Text="{Binding AppTypeDistribution, Source={x:Static strings:StringResources.Current}}"
                                          FontSize="16"
                                          FontWeight="SemiBold"/>

                                <ItemsControl ItemsSource="{Binding CategoryStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                                <!-- 类别名称 + 百分比 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding Category}"
                                                              Classes="body"/>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding PercentageText}"
                                                              Classes="caption"
                                                              FontWeight="SemiBold"/>
                                                </Grid>
                                                <!-- 进度条 -->
                                                <ProgressBar Value="{Binding Percentage}"
                                                            Maximum="100"
                                                            Height="8"
                                                            CornerRadius="4"/>
                                                <!-- 时长 -->
                                                <TextBlock Text="{Binding DurationText}"
                                                          Classes="caption"
                                                          Opacity="0.7"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空数据提示 -->
                                <TextBlock Text="{Binding NoDataAvailable, Source={x:Static strings:StringResources.Current}}"
                                          Classes="caption"
                                          HorizontalAlignment="Center"
                                          Opacity="0.6"
                                          IsVisible="{Binding ShowEmptyState}"/>
                            </StackPanel>

                            <!-- 右侧：Top 10 应用 -->
                            <StackPanel Grid.Column="2" Spacing="16">
                                <TextBlock Text="{Binding TopAppsTitle, Source={x:Static strings:StringResources.Current}}"
                                          FontSize="16"
                                          FontWeight="SemiBold"/>

                                <ItemsControl ItemsSource="{Binding TopApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6"
                                                   CornerRadius="6"
                                                   Margin="0,0,0,4">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource HoverBackground}"/>
                                                    </Style>
                                                </Border.Styles>

                                                <Grid ColumnDefinitions="30,32,*,100,80">
                                                    <!-- 排名 -->
                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding RankText}"
                                                              Classes="body"
                                                              FontWeight="SemiBold"
                                                              Foreground="{StaticResource SecondaryText}"/>

                                                    <!-- 图标 -->
                                                    <Image Grid.Column="1"
                                                          Source="{Binding Icon}"
                                                          Width="24"
                                                          Height="24"
                                                          Margin="0,0,8,0"/>

                                                    <!-- 应用名 -->
                                                    <TextBlock Grid.Column="2"
                                                              Text="{Binding AppName}"
                                                              Classes="body"
                                                              TextTrimming="CharacterEllipsis"/>

                                                    <!-- 时长 -->
                                                    <TextBlock Grid.Column="3"
                                                              Text="{Binding DurationText}"
                                                              Classes="body"
                                                              Margin="12,0,0,0"
                                                              TextAlignment="Right"/>

                                                    <!-- 百分比 -->
                                                    <TextBlock Grid.Column="4"
                                                              Text="{Binding PercentageText}"
                                                              Classes="caption"
                                                              Foreground="{StaticResource PrimaryGradient}"
                                                              Margin="8,0,0,0"
                                                              TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空数据提示 -->
                                <TextBlock Text="{Binding NoDataAvailable, Source={x:Static strings:StringResources.Current}}"
                                          Classes="caption"
                                          HorizontalAlignment="Center"
                                          Opacity="0.6"
                                          IsVisible="{Binding ShowEmptyState}"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- Empty State - Welcome Guide -->
                    <Border IsVisible="{Binding ShowEmptyState}"
                           Classes="card"
                           Padding="32"
                           Margin="0,20,0,20">
                        <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="400">
                            <!-- Icon -->
                            <TextBlock Text="📊"
                                      FontSize="56"
                                      HorizontalAlignment="Center"
                                      Opacity="0.9"/>

                            <!-- Title -->
                            <TextBlock Text="{Binding EmptyStateTitle, Source={x:Static strings:StringResources.Current}}"
                                      Classes="heading"
                                      FontSize="20"
                                      HorizontalAlignment="Center"
                                      TextAlignment="Center"/>

                            <!-- Description -->
                            <TextBlock Text="{Binding EmptyStateDescription, Source={x:Static strings:StringResources.Current}}"
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      Classes="caption"
                                      Opacity="0.75"
                                      LineHeight="22"/>

                            <!-- Features -->
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding EmptyStateFeature1, Source={x:Static strings:StringResources.Current}}" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding EmptyStateFeature2, Source={x:Static strings:StringResources.Current}}" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="✓" Foreground="#34C759" FontWeight="Bold" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding EmptyStateFeature3, Source={x:Static strings:StringResources.Current}}" Classes="caption" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hint -->
                            <TextBlock Text="{Binding EmptyStateHint, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"
                                      FontSize="11"
                                      Opacity="0.65"
                                      HorizontalAlignment="Center"
                                      TextAlignment="Center"
                                      TextWrapping="Wrap"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 底部占位元素,确保滚动空间充足 -->
                    <Border Height="1" Background="Transparent"/>
                </StackPanel>
            </ScrollViewer>
    </Grid>
</Window>

