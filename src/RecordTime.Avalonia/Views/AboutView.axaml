<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecordTime.Avalonia.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="900" Margin="48,40,48,80">
            <!-- Page Title -->
            <TextBlock Text="{Binding AboutTitle, Source={x:Static strings:StringResources.Current}}"
                      Classes="title"
                      Margin="0,0,0,16"/>

            <!-- App Icon and Name -->
            <Border Classes="card"
                   Padding="32,40">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️"
                              FontSize="64"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppName}"
                              Classes="title"
                              HorizontalAlignment="Center"
                              FontSize="32"/>
                    <TextBlock Classes="heading"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource SecondaryText}">
                        <Run Text="{Binding VersionPrefix, Source={x:Static strings:StringResources.Current}}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Version}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding AppDescriptionTitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>
                    <TextBlock Text="{Binding AppDescription, Source={x:Static strings:StringResources.Current}}"
                              Classes="body"
                              TextWrapping="Wrap"
                              LineHeight="24"/>

                    <!-- Privacy Emphasis -->
                    <Border Padding="16,12"
                           Background="#1A34C759"
                           BorderBrush="#34C759"
                           BorderThickness="2"
                           CornerRadius="10"
                           Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒"
                                          FontSize="20"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PrivacyPromise, Source={x:Static strings:StringResources.Current}}"
                                          Classes="body"
                                          FontWeight="SemiBold"
                                          Foreground="#34C759"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PrivacyPromiseDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"
                                      TextWrapping="Wrap"
                                      LineHeight="20"
                                      Opacity="0.85"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Core Features -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding CoreFeatures, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>
                    <TextBlock Text="{Binding CoreFeaturesSubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              Opacity="0.7"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding CoreFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{StaticResource HoverBackground}"
                                       CornerRadius="8"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Classes="body"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Security Features -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DataSecurity, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>
                    <TextBlock Text="{Binding DataSecuritySubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              Opacity="0.7"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding SecurityFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{StaticResource HoverBackground}"
                                       CornerRadius="8"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Classes="body"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- UX Features -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding UserExperience, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>
                    <TextBlock Text="{Binding UserExperienceSubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              Opacity="0.7"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding UXFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{StaticResource HoverBackground}"
                                       CornerRadius="8"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Classes="body"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Technology Stack -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding TechStack, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>
                    <TextBlock Text="{Binding TechStack}"
                              Classes="body"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Links, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>

                    <Grid ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0"
                               Content="{Binding GitHubRepo, Source={x:Static strings:StringResources.Current}}"
                               Classes="secondary"
                               Command="{Binding OpenGitHubCommand}"
                               HorizontalAlignment="Stretch"
                               Height="44"/>

                        <Button Grid.Column="2"
                               Content="{Binding OpenSourceLicense, Source={x:Static strings:StringResources.Current}}"
                               Classes="secondary"
                               Command="{Binding OpenLicenseCommand}"
                               HorizontalAlignment="Stretch"
                               Height="44"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Copyright -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Copyright}"
                              Classes="body"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding MadeWithLove, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource SecondaryText}"
                              FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- 底部占位元素,确保滚动空间充足 -->
            <Border Height="1" Background="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
