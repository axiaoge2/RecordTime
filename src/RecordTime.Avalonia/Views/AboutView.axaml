<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecordTime.Avalonia.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="900" Margin="24,24,24,48">
            <!-- Page Title -->
            <TextBlock Text="{Binding AboutTitle, Source={x:Static strings:StringResources.Current}}"
                       Classes="H3"
                       Theme="{DynamicResource TitleTextBlock}"
                       Margin="0,0,0,8"/>

            <!-- App Icon and Name -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="32,40">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️"
                              FontSize="64"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppName}"
                              Classes="H4"
                              Theme="{DynamicResource TitleTextBlock}"
                              HorizontalAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Center"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}">
                        <Run Text="{Binding VersionPrefix, Source={x:Static strings:StringResources.Current}}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Version}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding AppDescriptionTitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding AppDescription, Source={x:Static strings:StringResources.Current}}"
                              Theme="{DynamicResource TextBlockBase}"
                              TextWrapping="Wrap"
                              LineHeight="24"/>

                    <!-- Privacy Emphasis -->
                    <Border Padding="16,12"
                           Background="{DynamicResource SemiColorSuccessLight}"
                           BorderBrush="{DynamicResource SemiColorSuccess}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒"
                                          FontSize="20"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PrivacyPromise, Source={x:Static strings:StringResources.Current}}"
                                          Theme="{DynamicResource TextBlockBase}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource SemiColorSuccess}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PrivacyPromiseDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"
                                      TextWrapping="Wrap"
                                      LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Core Features -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding CoreFeatures, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding CoreFeaturesSubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding CoreFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{DynamicResource SemiColorFill0}"
                                       CornerRadius="4"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Theme="{DynamicResource TextBlockBase}"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Security Features -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DataSecurity, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding DataSecuritySubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding SecurityFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{DynamicResource SemiColorFill0}"
                                       CornerRadius="4"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Theme="{DynamicResource TextBlockBase}"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- UX Features -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding UserExperience, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding UserExperienceSubtitle, Source={x:Static strings:StringResources.Current}}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding UXFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                       Background="{DynamicResource SemiColorFill0}"
                                       CornerRadius="4"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                              Theme="{DynamicResource TextBlockBase}"
                                              TextWrapping="Wrap"
                                              LineHeight="22"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Technology Stack -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding TechStack, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding TechStack}"
                              Theme="{DynamicResource TextBlockBase}"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Links, Source={x:Static strings:StringResources.Current}}"
                              Classes="H6"
                              Theme="{DynamicResource TitleTextBlock}"/>

                    <Grid ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0"
                               Content="{Binding GitHubRepo, Source={x:Static strings:StringResources.Current}}"
                               Theme="{DynamicResource SemiButtonSecondary}"
                               Command="{Binding OpenGitHubCommand}"
                               HorizontalAlignment="Stretch"
                               Height="32"/>

                        <Button Grid.Column="2"
                               Content="{Binding OpenSourceLicense, Source={x:Static strings:StringResources.Current}}"
                               Theme="{DynamicResource SemiButtonSecondary}"
                               Command="{Binding OpenLicenseCommand}"
                               HorizontalAlignment="Stretch"
                               Height="32"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Copyright -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Copyright}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MadeWithLove, Source={x:Static strings:StringResources.Current}}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              HorizontalAlignment="Center"
                              FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- 底部占位元素,确保滚动空间充足 -->
            <Border Height="24" Background="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>