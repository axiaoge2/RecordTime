<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             xmlns:local="using:RecordTime.Avalonia.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="RecordTime.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="800" Margin="24,24,24,48">
            <!-- Page Title -->
            <TextBlock Text="{Binding Settings, Source={x:Static strings:StringResources.Current}}"
                      FontSize="32" 
                      FontFamily="{DynamicResource EditorialSerifFont}"
                      FontWeight="Normal"
                      Foreground="{DynamicResource LinearFgPrimaryBrush}"/>

            <!-- Status Bar - Editorial Style -->
            <Border BorderBrush="{DynamicResource LinearBorderFocusBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                     <PathIcon Data="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z" 
                               Width="16" Height="16"
                               Foreground="{DynamicResource SemiColorPrimary}"/>
                     <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- General Settings -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="24">
                    <TextBlock Text="{Binding GeneralSettings, Source={x:Static strings:StringResources.Current}}"
                              Classes="H5"
                              Theme="{DynamicResource TitleTextBlock}"/>

                    <!-- Auto Start -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding AutoStart, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AutoStartDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Classes="Small"/>

                    <!-- Minimize to Tray -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding MinimizeToTray, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MinimizeToTrayDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding MinimizeToTray}"
                                     Command="{Binding ToggleMinimizeToTrayCommand}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Classes="Small"/>

                    <!-- Notifications -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding ShowNotifications, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ShowNotificationsDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding ShowNotifications}"
                                     Command="{Binding ToggleShowNotificationsCommand}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Classes="Small"/>

                    <!-- Language -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Language, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LanguageDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                 ItemsSource="{Binding LanguageOptions}"
                                 SelectedItem="{Binding SelectedLanguageOption}"
                                 Width="200"
                                 VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Separator Classes="Small"/>

                    <!-- Theme -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Theme, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ThemeDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   Spacing="16"
                                   VerticalAlignment="Center">
                            <RadioButton Content="{Binding ThemeLight, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}"
                                        GroupName="Theme"/>
                            <RadioButton Content="{Binding ThemeDark, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}"
                                        GroupName="Theme"/>
                            <RadioButton Content="{Binding ThemeAuto, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=2}"
                                        GroupName="Theme"/>
                        </StackPanel>
                    </Grid>

                    <Separator Classes="Small"/>

                    <!-- Idle Timeout -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding IdleTimeout, Source={x:Static strings:StringResources.Current}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding IdleTimeoutDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="Tertiary"
                                      Theme="{DynamicResource TextBlockBase}"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                      Value="{Binding IdleTimeoutMinutes}"
                                      Minimum="1"
                                      Maximum="60"
                                      Increment="1"
                                      Width="120"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database Management -->
            <Border Theme="{DynamicResource SemiBorderCard}" Padding="24">
                <StackPanel Spacing="24">
                    <TextBlock Text="{Binding DataManagement, Source={x:Static strings:StringResources.Current}}"
                              Classes="H5"
                              Theme="{DynamicResource TitleTextBlock}"/>

                    <!-- Database Info -->
                    <Border Padding="16"
                           Theme="{DynamicResource SemiBorderCard}"
                           Background="{DynamicResource SemiColorFill0}"
                           CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                          Text="{Binding DatabasePath, Source={x:Static strings:StringResources.Current}}"
                                          Classes="Tertiary"
                                          Theme="{DynamicResource TextBlockBase}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding DatabasePath}"
                                          Classes="Tertiary"
                                          Theme="{DynamicResource TextBlockBase}"
                                          TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0"
                                          Text="{Binding DatabaseSize, Source={x:Static strings:StringResources.Current}}"
                                          Classes="Tertiary"
                                          Theme="{DynamicResource TextBlockBase}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding DatabaseSize}"
                                          Classes="Tertiary"
                                          Theme="{DynamicResource TextBlockBase}"
                                          Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2"
                                          Text="{Binding TotalSessions, StringFormat='{}{0} records total'}"
                                          Classes="Tertiary"
                                          Theme="{DynamicResource TextBlockBase}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Database Actions -->
                    <Grid ColumnDefinitions="*, 12, *, 12, *">
                        <Button Grid.Column="0" Content="{Binding OpenDatabaseFolder, Source={x:Static strings:StringResources.Current}}"
                               Theme="{DynamicResource SemiButtonSecondary}"
                               HorizontalAlignment="Stretch"
                               Command="{Binding OpenDatabaseFolderCommand}"/>
                        <Button Grid.Column="2" Content="{Binding BackupDatabase, Source={x:Static strings:StringResources.Current}}"
                               Theme="{DynamicResource SemiButtonSecondary}"
                               HorizontalAlignment="Stretch"
                               Command="{Binding BackupDatabaseCommand}"/>
                        <Button Grid.Column="4" Content="{Binding ClearOldData, Source={x:Static strings:StringResources.Current}}"
                               Theme="{DynamicResource SemiButtonSecondary}"
                               HorizontalAlignment="Stretch"
                               Command="{Binding ClearOldDataCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ClearOldDataWarning, Source={x:Static strings:StringResources.Current}}"
                              Classes="Tertiary"
                              Theme="{DynamicResource TextBlockBase}"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource SemiColorWarning}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>