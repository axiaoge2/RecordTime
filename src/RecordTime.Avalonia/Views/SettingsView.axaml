<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             xmlns:local="using:RecordTime.Avalonia.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecordTime.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="900" Margin="48,40,48,80">
            <!-- Page Title -->
            <TextBlock Text="{Binding Settings, Source={x:Static strings:StringResources.Current}}"
                      Classes="title"
                      Margin="0,0,0,16"/>

            <!-- Status Bar -->
            <Border Padding="12"
                   Background="{StaticResource HoverBackground}"
                   CornerRadius="8">
                <TextBlock Text="{Binding StatusText}"
                          Classes="body"
                          TextAlignment="Center"/>
            </Border>

            <!-- General Settings -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding GeneralSettings, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>

                    <!-- Auto Start -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding AutoStart, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AutoStartDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Minimize to Tray -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding MinimizeToTray, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MinimizeToTrayDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding MinimizeToTray}"
                                     Command="{Binding ToggleMinimizeToTrayCommand}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Notifications -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding ShowNotifications, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ShowNotificationsDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding ShowNotifications}"
                                     Command="{Binding ToggleShowNotificationsCommand}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Language -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Language, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LanguageDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                 ItemsSource="{Binding LanguageOptions}"
                                 SelectedItem="{Binding SelectedLanguageOption}"
                                 Width="180"
                                 VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Theme -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Theme, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ThemeDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   Spacing="8"
                                   VerticalAlignment="Center">
                            <RadioButton Content="{Binding ThemeLight, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}"
                                        GroupName="Theme"/>
                            <RadioButton Content="{Binding ThemeDark, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}"
                                        GroupName="Theme"/>
                            <RadioButton Content="{Binding ThemeAuto, Source={x:Static strings:StringResources.Current}}"
                                        IsChecked="{Binding SelectedThemeIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=2}"
                                        GroupName="Theme"/>
                        </StackPanel>
                    </Grid>

                    <!-- Idle Timeout -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding IdleTimeout, Source={x:Static strings:StringResources.Current}}"
                                      Classes="body"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding IdleTimeoutDesc, Source={x:Static strings:StringResources.Current}}"
                                      Classes="caption"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                      Value="{Binding IdleTimeoutMinutes}"
                                      Minimum="1"
                                      Maximum="60"
                                      Increment="1"
                                      Width="120"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database Management -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding DataManagement, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>

                    <!-- Database Info -->
                    <Border Padding="12"
                           Background="{StaticResource HoverBackground}"
                           CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                          Text="{Binding DatabasePath, Source={x:Static strings:StringResources.Current}}"
                                          Classes="caption"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding DatabasePath}"
                                          Classes="caption"
                                          TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0"
                                          Text="{Binding DatabaseSize, Source={x:Static strings:StringResources.Current}}"
                                          Classes="caption"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding DatabaseSize}"
                                          Classes="caption"
                                          Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2"
                                          Text="{Binding TotalSessions, StringFormat='{}{0} records total'}"
                                          Classes="caption"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Database Actions -->
                    <UniformGrid Columns="3" ColumnSpacing="12">
                        <Button Content="{Binding OpenDatabaseFolder, Source={x:Static strings:StringResources.Current}}"
                               Classes="secondary"
                               Command="{Binding OpenDatabaseFolderCommand}"/>
                        <Button Content="{Binding BackupDatabase, Source={x:Static strings:StringResources.Current}}"
                               Classes="secondary"
                               Command="{Binding BackupDatabaseCommand}"/>
                        <Button Content="{Binding ClearOldData, Source={x:Static strings:StringResources.Current}}"
                               Classes="secondary"
                               Command="{Binding ClearOldDataCommand}"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding ClearOldDataWarning, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              TextWrapping="Wrap"
                              Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding AdvancedSettings, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>

                    <Button Content="{Binding OpenLogsFolder, Source={x:Static strings:StringResources.Current}}"
                           Classes="secondary"
                           Command="{Binding OpenLogsFolderCommand}"
                           HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding LogsDescription, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="card"
                   Padding="24,20,24,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding About, Source={x:Static strings:StringResources.Current}}"
                              Classes="heading"/>

                    <TextBlock Text="{Binding Version, Source={x:Static strings:StringResources.Current}}"
                              Classes="body"/>

                    <TextBlock Text="{Binding SettingsDescription, Source={x:Static strings:StringResources.Current}}"
                              Classes="body"
                              TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding SettingsFeatures, Source={x:Static strings:StringResources.Current}}"
                              Classes="body"
                              TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding SettingsCopyright, Source={x:Static strings:StringResources.Current}}"
                              Classes="caption"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 底部占位元素,确保滚动空间充足 -->
            <Border Height="1" Background="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
