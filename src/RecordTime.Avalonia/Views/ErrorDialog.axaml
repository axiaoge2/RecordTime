<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
        x:Class="RecordTime.Avalonia.Views.ErrorDialog"
        Title="{Binding Error, Source={x:Static strings:StringResources.Current}}"
        Width="500"
        Height="250"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SemiColorBackground0}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SemiColorFill0}"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 错误图标 -->
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="{DynamicResource SemiColorDangerLight}"
                        Margin="0,0,15,0">
                    <TextBlock Text="⚠️"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 标题文本 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"/>
                    <TextBlock x:Name="SubtitleText"
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息内容 -->
        <ScrollViewer Grid.Row="1"
                      Padding="20">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{DynamicResource SemiColorText1}"
                       LineHeight="22"/>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SemiColorFill0}"
                Padding="20,15"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <!-- 查看日志按钮 (可选) -->
                <Button x:Name="ViewLogsButton"
                        Content="{Binding ViewLogs, Source={x:Static strings:StringResources.Current}}"
                        Theme="{DynamicResource SemiButtonSecondary}"
                        IsVisible="False"
                        Click="OnViewLogsClick"/>

                <!-- 确定按钮 -->
                <Button x:Name="OkButton"
                        Content="{Binding OK, Source={x:Static strings:StringResources.Current}}"
                        Theme="{DynamicResource SemiButtonPrimary}"
                        Click="OnOkClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
