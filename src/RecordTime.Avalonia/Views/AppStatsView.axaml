<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecordTime.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="RecordTime.Avalonia.Views.AppStatsView"
             x:DataType="vm:AppStatsViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="24">
        <!-- Header & Filters -->
        <StackPanel Grid.Row="0" Spacing="24" Margin="0,0,0,24">
            <!-- Title & Date Range -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel>
                    <TextBlock Text="{Binding AppStatsTitle, Source={x:Static strings:StringResources.Current}}" 
                               Classes="H3" 
                               Theme="{DynamicResource TitleTextBlock}"/>
                    <TextBlock Text="{Binding DateRangeText}" 
                               Classes="Tertiary" 
                               Theme="{DynamicResource TextBlockBase}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{Binding Today, Source={x:Static strings:StringResources.Current}}" 
                            Command="{Binding SetTodayCommand}" 
                            Theme="{DynamicResource SemiButtonSecondary}"/>
                    <Button Content="{Binding Yesterday, Source={x:Static strings:StringResources.Current}}" 
                            Command="{Binding SetYesterdayCommand}" 
                            Theme="{DynamicResource SemiButtonSecondary}"/>
                    <Button Content="{Binding ThisWeek, Source={x:Static strings:StringResources.Current}}" 
                            Command="{Binding SetThisWeekCommand}" 
                            Theme="{DynamicResource SemiButtonSecondary}"/>
                    <Button Content="{Binding ThisMonth, Source={x:Static strings:StringResources.Current}}" 
                            Command="{Binding SetThisMonthCommand}" 
                            Theme="{DynamicResource SemiButtonSecondary}"/>
                    <!-- DatePicker -->
                    <CalendarDatePicker SelectedDate="{Binding StartDate}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <Grid ColumnDefinitions="*,16,*,16,*">
                <Border Grid.Column="0" Theme="{DynamicResource SemiBorderCard}" Padding="24">
                     <StackPanel>
                         <TextBlock Text="{Binding TotalUsageTime, Source={x:Static strings:StringResources.Current}}" 
                                    Classes="Tertiary" 
                                    Theme="{DynamicResource TextBlockBase}"/>
                         <TextBlock Text="{Binding TotalDuration}" 
                                    Classes="H2" 
                                    Theme="{DynamicResource TitleTextBlock}" 
                                    Margin="0,8,0,0"/>
                     </StackPanel>
                </Border>
                <Border Grid.Column="2" Theme="{DynamicResource SemiBorderCard}" Padding="24">
                     <StackPanel>
                         <TextBlock Text="{Binding TotalSessions, Source={x:Static strings:StringResources.Current}}" 
                                    Classes="Tertiary" 
                                    Theme="{DynamicResource TextBlockBase}"/>
                         <TextBlock Text="{Binding TotalSessions}" 
                                    Classes="H2" 
                                    Theme="{DynamicResource TitleTextBlock}" 
                                    Margin="0,8,0,0"/>
                     </StackPanel>
                </Border>
                <Border Grid.Column="4" Theme="{DynamicResource SemiBorderCard}" Padding="24">
                     <StackPanel>
                         <TextBlock Text="{Binding CurrentDisplayApps, Source={x:Static strings:StringResources.Current}}" 
                                    Classes="Tertiary" 
                                    Theme="{DynamicResource TextBlockBase}"/>
                         <TextBlock Text="{Binding TotalAppCount}" 
                                    Classes="H2" 
                                    Theme="{DynamicResource TitleTextBlock}" 
                                    Margin="0,8,0,0"/>
                     </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchText}" 
                     Watermark="{Binding SearchAppPlaceholder, Source={x:Static strings:StringResources.Current}}" 
                     Width="300" 
                     Classes="ClearButton" 
                     HorizontalAlignment="Left"/>
            
            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding SelectedCategory}" 
                      PlaceholderText="{Binding AllCategories, Source={x:Static strings:StringResources.Current}}" 
                      Width="180" 
                      Margin="16,0"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Apps}" 
                  IsReadOnly="True" 
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowBackground="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SemiColorBorder}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding ColumnAppName, Source={x:Static strings:StringResources.Current}}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,8">
                                <Image Source="{Binding Icon}" Width="32" Height="32"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" 
                                               Theme="{DynamicResource TextBlockBase}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProcessName}" 
                                               Classes="Tertiary"
                                               Theme="{DynamicResource TextBlockBase}"
                                               FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding ColumnCategory, Source={x:Static strings:StringResources.Current}}" 
                                    Binding="{Binding Category}" 
                                    Width="120"/>
                <DataGridTextColumn Header="{Binding ColumnUsageTime, Source={x:Static strings:StringResources.Current}}" 
                                    Binding="{Binding DurationText}" 
                                    Width="120"/>
                <DataGridTextColumn Header="{Binding ColumnLastUsed, Source={x:Static strings:StringResources.Current}}" 
                                    Binding="{Binding LastUsedText}" 
                                    Width="120"/>
                <DataGridTemplateColumn Header="{Binding ColumnPercentage, Source={x:Static strings:StringResources.Current}}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PercentageText}" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,0,12,0"
                                       Theme="{DynamicResource TextBlockBase}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>