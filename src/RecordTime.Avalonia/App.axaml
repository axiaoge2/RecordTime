<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RecordTime.Avalonia.App"
             xmlns:local="using:RecordTime.Avalonia"
             xmlns:strings="using:RecordTime.Avalonia.Resources.Strings">
             <!-- Dual Theme Design System with Glassmorphism support -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ========== Light Theme ========== -->
                <ResourceDictionary x:Key="Light">
                    <!-- Base Colors -->
                    <Color x:Key="BaseColor">#F5F5F7</Color>
                    <Color x:Key="SurfaceColor">#FFFFFF</Color>
                    <Color x:Key="HoverColor">#ECEFF4</Color>
                    <Color x:Key="BorderColor">#E5E5EA</Color>
                    <Color x:Key="DividerColor">#D1D1D6</Color>

                    <!-- Text Colors -->
                    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
                    <Color x:Key="TextSecondaryColor">#3A3A3C</Color>
                    <Color x:Key="TextTertiaryColor">#8E8E93</Color>

                    <!-- Widget Gradient Colors -->
                    <Color x:Key="WidgetGradientStart">#FDFCFE</Color>
                    <Color x:Key="WidgetGradientEnd">#F2F3F7</Color>

                    <!-- Card Shadow -->
                    <Color x:Key="CardShadowColor">#0A000000</Color>
                    <Color x:Key="WidgetShadowColor">#13000000</Color>

                    <!-- Glass Colors (Light theme - subtle) -->
                    <Color x:Key="GlassBackgroundStart">#08000000</Color>
                    <Color x:Key="GlassBackgroundEnd">#04000000</Color>
                    <Color x:Key="GlassBorderStart">#15000000</Color>
                    <Color x:Key="GlassBorderEnd">#08000000</Color>
                    <Color x:Key="GlassGlowColor">#200071E3</Color>
                </ResourceDictionary>

                <!-- ========== Dark Theme ========== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Base Colors -->
                    <Color x:Key="BaseColor">#0D0D0D</Color>
                    <Color x:Key="SurfaceColor">#1A1A1C</Color>
                    <Color x:Key="HoverColor">#2C2C2E</Color>
                    <Color x:Key="BorderColor">#3A3A3C</Color>
                    <Color x:Key="DividerColor">#48484A</Color>

                    <!-- Text Colors -->
                    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
                    <Color x:Key="TextSecondaryColor">#EBEBF5</Color>
                    <Color x:Key="TextTertiaryColor">#8E8E93</Color>

                    <!-- Widget Gradient Colors -->
                    <Color x:Key="WidgetGradientStart">#242426</Color>
                    <Color x:Key="WidgetGradientEnd">#1C1C1E</Color>

                    <!-- Card Shadow -->
                    <Color x:Key="CardShadowColor">#30000000</Color>
                    <Color x:Key="WidgetShadowColor">#40000000</Color>

                    <!-- Glass Colors (Dark theme - prominent) -->
                    <Color x:Key="GlassBackgroundStart">#18FFFFFF</Color>
                    <Color x:Key="GlassBackgroundEnd">#08FFFFFF</Color>
                    <Color x:Key="GlassBorderStart">#25FFFFFF</Color>
                    <Color x:Key="GlassBorderEnd">#0DFFFFFF</Color>
                    <Color x:Key="GlassGlowColor">#400071E3</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ========== Shared Colors (Theme Independent) ========== -->
            <!-- System Accent Colors - Apple Official Palette -->
            <Color x:Key="AccentBlue">#0071E3</Color>
            <Color x:Key="AccentGreen">#30D158</Color>
            <Color x:Key="AccentOrange">#FF9500</Color>
            <Color x:Key="AccentRed">#FF3B30</Color>
            <Color x:Key="AccentPurple">#BF5AF2</Color>
            <Color x:Key="AccentCyan">#06B6D4</Color>

            <!-- Accent Brushes -->
            <SolidColorBrush x:Key="SystemBlue" Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="SystemGreen" Color="{StaticResource AccentGreen}"/>
            <SolidColorBrush x:Key="SystemOrange" Color="{StaticResource AccentOrange}"/>
            <SolidColorBrush x:Key="SystemRed" Color="{StaticResource AccentRed}"/>
            <SolidColorBrush x:Key="SystemPurple" Color="{StaticResource AccentPurple}"/>
            <SolidColorBrush x:Key="SystemCyan" Color="{StaticResource AccentCyan}"/>

            <!-- Primary Gradient -->
            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentCyan}" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ========== Theme-Aware Styles ========== -->
        <Style>
            <Style.Resources>
                <!-- Theme-Aware Brushes using DynamicResource -->
                <SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource BaseColor}"/>
                <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource SurfaceColor}"/>
                <SolidColorBrush x:Key="HoverBackground" Color="{DynamicResource HoverColor}"/>
                <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
                <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}"/>

                <SolidColorBrush x:Key="PrimaryText" Color="{DynamicResource TextPrimaryColor}"/>
                <SolidColorBrush x:Key="SecondaryText" Color="{DynamicResource TextSecondaryColor}"/>
                <SolidColorBrush x:Key="TertiaryText" Color="{DynamicResource TextTertiaryColor}"/>

                <!-- Widget Tint Gradient -->
                <LinearGradientBrush x:Key="WidgetTint" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource WidgetGradientStart}" Offset="0"/>
                    <GradientStop Color="{DynamicResource WidgetGradientEnd}" Offset="1"/>
                </LinearGradientBrush>
            </Style.Resources>
        </Style>

        <!-- ========== Window Style ========== -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="FontFamily" Value="-apple-system, SF Pro Display, Segoe UI, PingFang SC, Microsoft YaHei"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- ========== Widget Card Style (Apple-inspired) ========== -->
        <Style Selector="Border.widget-card">
            <Setter Property="Background" Value="{DynamicResource WidgetTint}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                        <GradientStop Color="#0D000000" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BoxShadow" Value="0 25 55 0 #13000000, 0 1 0 0 #33FFFFFF"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.widget-card:pointerover">
            <Setter Property="Opacity" Value="0.97"/>
            <Setter Property="BoxShadow" Value="0 35 65 0 #1A000000, 0 1 0 0 #55FFFFFF"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Standard Card Style ========== -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #0A000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="0 12 32 0 #0F000000"/>
        </Style>

        <!-- ========== Glassmorphism Card Style (Dark theme optimized) ========== -->
        <Style Selector="Border.glass-card">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource GlassBackgroundStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GlassBackgroundEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource GlassBorderStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GlassBorderEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 30 0 #200071E3, 0 8 32 0 #10000000"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.glass-card:pointerover">
            <Setter Property="BoxShadow" Value="0 0 40 0 #300071E3, 0 12 40 0 #15000000"/>
        </Style>

        <!-- ========== Glass Widget Card (larger, for dashboard) ========== -->
        <Style Selector="Border.glass-widget">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource GlassBackgroundStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GlassBackgroundEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource GlassBorderStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GlassBorderEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 40 0 #250071E3, 0 20 50 0 #12000000"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.glass-widget:pointerover">
            <Setter Property="BoxShadow" Value="0 0 50 0 #350071E3, 0 25 60 0 #18000000"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Gradient Accent Card ========== -->
        <Style Selector="Border.gradient-card">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 12 40 0 #300071E3"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.gradient-card:pointerover">
            <Setter Property="BoxShadow" Value="0 16 50 0 #400071E3"/>
        </Style>

        <!-- ========== Glass Accent Card ========== -->
        <Style Selector="Border.glass-accent">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#300071E3" Offset="0"/>
                        <GradientStop Color="#2006B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#500071E3"/>
            <Setter Property="BoxShadow" Value="0 0 50 0 #400071E3"/>
        </Style>

        <!-- ========== Button Styles ========== -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource SystemBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.88"/>
        </Style>

        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- Glass Button -->
        <Style Selector="Button.glass">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource GlassBackgroundStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GlassBackgroundEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource GlassBorderStart}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.glass:pointerover">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#12FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Primary Button -->
        <Style Selector="Button.glass-primary">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="BorderBrush" Value="#500071E3"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.glass-primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="Opacity" Value="0.95"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Sidebar Button Style -->
        <Style Selector="Button.sidebar-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                        <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.sidebar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- ========== Typography Styles ========== -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="LetterSpacing" Value="-0.5"/>
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryText}"/>
        </Style>

        <Style Selector="TextBlock.number-large">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="LetterSpacing" Value="-1"/>
        </Style>

        <Style Selector="TextBlock.number-widget">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="LetterSpacing" Value="-0.5"/>
        </Style>

        <!-- ========== ListBox Item Style ========== -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SystemBlue}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ========== Separator Style ========== -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Height" Value="0.5"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>

        <!-- ========== TextBox Style ========== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource SystemBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Glass TextBox -->
        <Style Selector="TextBox.glass">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource SystemBlue}"/>
            <Setter Property="SelectionBrush" Value="#400071E3"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource GlassBackgroundStart}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource GlassBorderStart}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TextBox.glass:focus">
            <Setter Property="BorderBrush" Value="{StaticResource SystemBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ========== ComboBox Style ========== -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource SystemBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <!-- ========== ProgressBar Styles ========== -->
        <Style Selector="ProgressBar.glass">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource GlassBackgroundStart}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource PrimaryGradient}"/>
        </Style>

        <!-- ========== ToggleSwitch Style ========== -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- ========== ScrollViewer Style ========== -->
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Application.Styles>
</Application>
