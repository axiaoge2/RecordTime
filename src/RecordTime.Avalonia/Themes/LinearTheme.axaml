<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         Linear Theme - 主题入口文件喵～
         Inspired by Linear.app
         ============================================ -->

    <ResourceDictionary.MergedDictionaries>
        <!-- 基础颜色 -->
        <ResourceInclude Source="avares://RecordTime/Themes/LinearColors.axaml"/>
        <!-- 图标 -->
        <ResourceInclude Source="avares://RecordTime/Themes/LinearIcons.axaml"/>
        <!-- 组件样式 -->
        <ResourceInclude Source="avares://RecordTime/Themes/LinearStyles.axaml"/>
        <!-- 深色主题 (默认) -->
        <ResourceInclude Source="avares://RecordTime/Themes/LinearDark.axaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
