<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ============================================
         Linear Style Color System - 浮浮酱精心设计喵～
         ============================================ -->
    
    <!-- ========== 品牌色 / Brand Colors ========== -->
    <Color x:Key="LinearAccentPrimary">#7C3AED</Color>
    <Color x:Key="LinearAccentSecondary">#3B82F6</Color>
    <Color x:Key="LinearAccentGradientStart">#7C3AED</Color>
    <Color x:Key="LinearAccentGradientEnd">#3B82F6</Color>
    
    <!-- ========== 状态色 / Status Colors ========== -->
    <Color x:Key="LinearSuccess">#10B981</Color>
    <Color x:Key="LinearWarning">#F59E0B</Color>
    <Color x:Key="LinearError">#EF4444</Color>
    <Color x:Key="LinearInfo">#3B82F6</Color>
    
    <!-- ========== 图表色 / Chart Colors ========== -->
    <Color x:Key="LinearChart1">#7C3AED</Color>
    <Color x:Key="LinearChart2">#3B82F6</Color>
    <Color x:Key="LinearChart3">#10B981</Color>
    <Color x:Key="LinearChart4">#F59E0B</Color>
    <Color x:Key="LinearChart5">#EF4444</Color>
    <Color x:Key="LinearChart6">#EC4899</Color>
    <Color x:Key="LinearChart7">#8B5CF6</Color>
    <Color x:Key="LinearChart8">#06B6D4</Color>
    
</ResourceDictionary>
