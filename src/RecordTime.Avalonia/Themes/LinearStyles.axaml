<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         Linear Style Component Styles - 组件样式喵～
         ============================================ -->

    <!-- ========== 设计规范 / Design Tokens ========== -->
    <CornerRadius x:Key="LinearRadiusSm">0</CornerRadius>
    <CornerRadius x:Key="LinearRadiusMd">2</CornerRadius>
    <CornerRadius x:Key="LinearRadiusLg">2</CornerRadius>
    <CornerRadius x:Key="LinearRadiusXl">4</CornerRadius>
    <CornerRadius x:Key="LinearRadiusFull">9999</CornerRadius>

    <Thickness x:Key="LinearSpacingXs">4</Thickness>
    <Thickness x:Key="LinearSpacingSm">8</Thickness>
    <Thickness x:Key="LinearSpacingMd">12</Thickness>
    <Thickness x:Key="LinearSpacingLg">16</Thickness>
    <Thickness x:Key="LinearSpacingXl">24</Thickness>
    <Thickness x:Key="LinearSpacing2xl">32</Thickness>

    <x:Double x:Key="LinearFontSizeXs">11</x:Double>
    <x:Double x:Key="LinearFontSizeSm">12</x:Double>
    <x:Double x:Key="LinearFontSizeMd">14</x:Double>
    <x:Double x:Key="LinearFontSizeLg">16</x:Double>
    <x:Double x:Key="LinearFontSizeXl">20</x:Double>
    <x:Double x:Key="LinearFontSize2xl">24</x:Double>
    <x:Double x:Key="LinearFontSize3xl">32</x:Double>
    <x:Double x:Key="LinearFontSize4xl">48</x:Double>

    <!-- ========== 卡片样式 / Card Styles ========== -->
    <ControlTheme x:Key="LinearCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LinearCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LinearCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource LinearRadiusLg}"/>
        <Setter Property="Padding" Value="24"/>
    </ControlTheme>

    <!-- ========== 文本样式 / Text Styles ========== -->
    <ControlTheme x:Key="LinearTextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource EditorialSerifFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSize4xl}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource EditorialSerifFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSize3xl}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource EditorialSerifFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSize2xl}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextH4" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSizeXl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSizeMd}"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgPrimaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSizeMd}"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgSecondaryBrush}"/>
    </ControlTheme>

    <ControlTheme x:Key="LinearTextMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource LinearFontSizeSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource LinearFgTertiaryBrush}"/>
    </ControlTheme>

    <!-- ========== 分隔线样式 / Separator ========== -->
    <ControlTheme x:Key="LinearSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LinearBorderSubtleBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,16"/>
    </ControlTheme>

</ResourceDictionary>
